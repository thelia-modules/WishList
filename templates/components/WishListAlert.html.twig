{# Styled by Flexy's AddToCartToast: same floating card, same close button. Stays in the DOM,
   hidden, so the component is mounted when the wishlist:alert event comes. #}
<div class="AddToCartToast WishlistAlert {% if not message %}hidden{% endif %}" role="status" {{ attributes }}>
	<button type="button" class="AddToCartToast-iconClose WishlistAlert-iconClose" aria-label="{{ this.closeLabel }}" data-action="live#action" data-live-action-param="closeToast">
		{{ ux_icon('close') }}
	</button>
	<p class="AddToCartToast-message WishlistAlert-message">
		{{ message }}
	</p>
</div>
